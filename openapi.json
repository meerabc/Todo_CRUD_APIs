{
  "openapi": "3.0.0",
  "info": { "title": "Task API", "version": "2.0.0" },
  "paths": {
    "/": {
      "get": {
        "summary": "API info",
        "responses": {
          "200": {
            "description": "Basic info about this API",
            "content": {
              "application/json": {
                "example": {
                  "name": "Task API",
                  "version": "1.0",
                  "endpoints": ["/tasks", "/stats", "/reset", "/health", "/auth", "/public", "/protected"]
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": { "example": { "status": "ok" } }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List tasks, with optional filtering, search, and sorted alphabetically by title",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "Filter by completion status (true or false)"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Return only tasks whose title contains this text (case-insensitive)"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of matching tasks, sorted alphabetically by title",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "title": "Complete Express assignment", "done": true },
                  { "id": 2, "title": "Review JavaScript arrays", "done": false }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "title": "Buy milk" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "example": { "id": 4, "title": "Buy milk", "done": false }
              }
            }
          },
          "400": {
            "description": "Missing, empty, or non-string title",
            "content": {
              "application/json": {
                "example": { "error": "title is mandatory" }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "summary": "Get a single task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "The matching task",
            "content": {
              "application/json": {
                "example": { "id": 1, "title": "Complete Express assignment", "done": true }
              }
            }
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "example": { "error": "Task 99 not found" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a task's title and/or done status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "title": "Buy oat milk", "done": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "example": { "id": 1, "title": "Buy oat milk", "done": true }
              }
            }
          },
          "400": {
            "description": "Empty body, non-string title, empty title, or non-boolean done",
            "content": {
              "application/json": {
                "example": { "error": "invalid body" }
              }
            }
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "example": { "error": "Task 99 does not exist" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted, no content returned"
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "example": { "error": "Task 99 does not exist" }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Task counts computed with SQL COUNT()",
        "responses": {
          "200": {
            "description": "Total, done, and open task counts",
            "content": {
              "application/json": {
                "example": { "total": 3, "done": 2, "open": 1 }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "summary": "Delete all tasks and restore the 3 original example tasks",
        "responses": {
          "200": {
            "description": "Tasks reset",
            "content": {
              "application/json": {
                "example": {
                  "message": "Tasks reset",
                  "tasks": [
                    { "id": 1, "title": "Complete Express assignment", "done": true },
                    { "id": 2, "title": "Review JavaScript arrays", "done": false },
                    { "id": 3, "title": "Push code to GitHub", "done": true }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "intern@flyrank.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully created"
          },
          "400": {
            "description": "Bad request (missing email/password)"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate a user and return a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "intern@flyrank.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated, returns access and refresh tokens"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Invalid login credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "End the user's session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully logged out"
          },
          "401": {
            "description": "Access token required or invalid"
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Read public, open data",
        "responses": {
          "200": {
            "description": "Returns a welcome message"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read private profile data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns user metadata"
          },
          "401": {
            "description": "Access token required or invalid"
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Read private dashboard data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns dashboard message and email"
          },
          "401": {
            "description": "Access token required or invalid"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}